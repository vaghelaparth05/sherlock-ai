# Copy this file to .env.local and fill it in. .env.local is git-ignored.

# Postgres from docker-compose.yml (host port 5435)
DATABASE_URL=postgres://sherlock:sherlock@localhost:5435/sherlock

# Your Google AI Studio / Gemini API key. Server-side only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: which Gemini model to use. "gemini-flash-latest" is an alias that tracks the current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Optional: set to "rules" to force the offline rules scanner (no AI) even if a key is present.
# SHERLOCK_SCANNER=rules

# --- Hosting on Netlify (set these in Site configuration > Environment variables, not here) ---
# DATABASE_URL    a hosted Postgres connection string, e.g. from Neon (include ?sslmode=require)
# GEMINI_API_KEY  as above
# SCAN_RUNNER     netlify   (runs scans in a Background Function instead of in the web request)
# SCAN_SECRET     any long random string; shared between the site and its scan worker
